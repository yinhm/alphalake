  "baseline": "repeat_latest",
  "benchmark": "zero_ocf",
  "candidate": "mean_two_ocf_margins",
  "definitions": {
    "target": "next_H1_TTM_reported_operating_cashflow",
    "formula": "current_TTM_revenue * (current_TTM_OCF/current_TTM_revenue + prior_same_season_TTM_OCF/prior_TTM_revenue)/2",
    "capex_forecast": "repeat_latest_nonnegative_TTM_capex_for_every_model",
    "cash_proxy": "forecast_OCF_minus_shared_capex_forecast; actual_reported_OCF_minus_actual_capex",
    "source": "FN234 four quarters; FN114 annual plus current H1 minus prior H1; FN230 four quarters",
    "scope": "positive current/prior revenue; negative and zero OCF retained; negative capex refused; no inventory/company filter"
  },
  "gates": {
    "minimum_pairs": 80,
    "minimum_primary_improvement_fraction": 0.05,
    "maximum_each_period_primary_ratio": 1.05,
    "require_wape_nonworse": true,
    "require_zero_benchmark_nonworse": true,
    "require_leave_one_company_out_nonworse": true,
    "require_cash_proxy_nonworse": true
  },
  "boundary": "既有固定规则的新公司复验；原60家开发不改，用于校验选择回执；120家排除本地研究samples/results已涉及公司，非新时间窗口、非严格PIT；当前生存者总体；不按未来误差/异常年份删样本；报表OCF及OCF减购建现金不是FCFF，不替换生产DCF。",
  "analysis_id": "tdx-operating-cash-new-companies-v1"
}
